NEXT_PUBLIC_SITE_URL=https://brisastory.live
# Set only in the separate Cloudflare staging Worker. This makes all pages
# noindex and disables newsletter delivery. Keep unset for production.
NEXT_PUBLIC_DEPLOY_ENV=production
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-8HCVVRV2ZS
NEXT_PUBLIC_GOOGLE_PRIVACY_MESSAGING_ENABLED=false
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://brisastory.live/api/threads/callback
THREADS_OAUTH_STATE_SECRET=
THREADS_OAUTH_SCOPES=threads_basic,threads_keyword_search
THREADS_ACCESS_TOKEN=
NEXT_PUBLIC_CONTACT_EMAIL=hello@brisastory.live
RESEND_API_KEY=your_resend_api_key_here
CONTACT_INBOX=hello@brisastory.live
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT_ID=PASTE_SLOT_ID
NEXT_PUBLIC_ADSENSE_CATEGORY_SLOT_ID=PASTE_SLOT_ID
NEXT_PUBLIC_ADSENSE_HOMEPAGE_SLOT_ID=PASTE_SLOT_ID
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Spotify Web API (server-only; used to resolve official album artwork)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
RAWG_API_KEY=your_rawg_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# --- Appwrite (server-only; never expose these to the browser) ---
# BrisaStory calls Appwrite exclusively from server-side route handlers, so
# none of these need a NEXT_PUBLIC_ prefix.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id_here
APPWRITE_API_KEY=your_appwrite_server_api_key_here
APPWRITE_DATABASE_ID=brisastory
APPWRITE_REACTIONS_COLLECTION_ID=reactions
APPWRITE_POLLS_COLLECTION_ID=poll_votes
APPWRITE_REACTION_LOCKS_COLLECTION_ID=reaction_locks
APPWRITE_POLL_BALLOTS_COLLECTION_ID=poll_ballots
APPWRITE_READ_STATS_COLLECTION_ID=read_stats
APPWRITE_QUICK_REACTIONS_COLLECTION_ID=quick_reactions
APPWRITE_QUICK_REACTION_LOCKS_COLLECTION_ID=quick_reaction_locks
APPWRITE_QUESTIONS_COLLECTION_ID=question_submissions
APPWRITE_QUESTION_REASONS_COLLECTION_ID=question_reasons
APPWRITE_QUESTION_REASON_QUOTAS_COLLECTION_ID=question_reason_quotas
APPWRITE_QUESTION_RELATIONS_COLLECTION_ID=question_relations
APPWRITE_COMMUNITY_SUBMISSIONS_COLLECTION_ID=community_submissions
APPWRITE_COMMUNITY_AUDIT_COLLECTION_ID=community_moderation_audit
APPWRITE_COMMUNITY_REPORTS_COLLECTION_ID=community_reports
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=brisastory-community
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_PUBLIC_URL=https://media.brisastory.live

# Salt used to hash anonymous visitor identity (IP + User-Agent) for
# reaction/poll/question deduplication. Doubles as the project's
# "VISITOR_HASH_SALT" — server-only, never logged.
INTERACTION_HASH_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE

# --- Upstash Redis (server-only) ---
# Used for rate limiting on /api/contact and /api/newsletter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- MailerLite (server-only) — "The Fresh Drop" newsletter ---
# MailerLite is the subscriber source of truth; nothing here is stored in
# Appwrite, and RESEND_API_KEY is never used for newsletter signups.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
APPWRITE_COMMUNITY_DRAFTS_COLLECTION_ID=community_drafts
